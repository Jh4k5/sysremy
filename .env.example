# ── Systemy — مثال إعدادات البيئة (لا أسرار هنا) ─────────────────
# انسخه إلى .env واملأ القيم: cp .env.example .env

# قاعدة البيانات المحلية (SQLite عبر Prisma — بيئة المعاينة فقط)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── أساس Supabase (المصادقة السحابية — اختياري) ──────────────────
# المشروع: Systemy
# المفتاح المطلوب هنا هو Publishable Key (sb_publishable_…) — عام
# بتصميم RLS وليس سراً. يجلب من: Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://ymzwfqqijtbmmclfuwcz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ملاحظات:
# - لا تضع service-role key أو كلمات مرور قاعدة البيانات هنا أبداً.
# - تفعيل Google OAuth (مفاتيح Google Cloud) وRedirect URLs يتم من
#   Supabase Dashboard — راجع docs/ui-redesign/supabase-foundation.md.
# - حدود خدمة البريد المدمجة ضيقة؛ للإنتاج اضبط SMTP مخصصاً.
